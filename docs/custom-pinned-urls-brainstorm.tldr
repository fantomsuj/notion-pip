    },
    {
      "id": "shape:a4-body",
      "typeName": "shape",
      "type": "text",
      "x": 710,
      "y": 785,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "props": {
        "text": "App has two modes. 'Notion mode' = today's behavior. 'Web mode' = simpler web view loading arbitrary URL. Toolbar toggle switches between them.\n\nPROS\n✓ Most isolated — almost a separate feature\n✓ Zero changes to Notion code paths\n✓ Easy to gate as beta\n✓ Clear mental model\n\nCONS\n✗ Feels like two apps glued together\n✗ Cannot mix Notion + web in recent pages shelf\n✗ Switching modes reloads content\n✗ 'Mode' concept adds UI complexity\n✗ Does not scale to multiple web URLs\n\nKEY FILES: new WebModeView.swift, PiPChromeView.swift, new WebModeCoordinator.swift, SettingsView.swift, AppRuntime.swift\n\nSWITCH BACK: Mode switcher button in toolbar — one click returns to Notion.",
        "size": "s",
        "font": "sans",
        "align": "start",
        "w": 660,
        "autoSize": false
      },
      "index": "b2",
      "parentId": "page:page"
    },
